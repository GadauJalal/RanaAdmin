# ---------------------------------------------------------------------------
# Rana54 Network Operations - environment
# ---------------------------------------------------------------------------
# Copy to `.env.local` and adjust.
#
# There are two modes:
#
#   DEMO (default) - NEXT_PUBLIC_DATA_SOURCE=mock. In-browser prototype state
#   (seeded, persisted in localStorage). Fully viewable with no backend.
#
#   LIVE - NEXT_PUBLIC_DATA_SOURCE=http plus a backend URL. The console signs
#   in as a real platform administrator and runs the backed operations for
#   real (create enterprise + provision its first administrator, platform
#   users, installer roster, act-by-id job flows). Areas the backend cannot
#   list yet stay empty; see docs/BACKEND_INTEGRATION_STATUS.md.

# Which data adapter the workspace uses: mock | http
NEXT_PUBLIC_DATA_SOURCE=mock

# Base URL every browser request goes through. Keep "/api" so the browser talks
# to this app's own proxy (same origin, so no CORS on the backend).
NEXT_PUBLIC_API_BASE_URL=/api

# --- LIVE backend -----------------------------------------------------------
# The Rana54 backend origin. NO path prefix - routes are mounted at the bare
# root (POST /auth/login, GET /admin/users, ...). Only the Swagger UI lives
# under /api. Server-side only.
# RANA_API_URL=https://staging.api.rana54.com

# Build-time equivalent of RANA_API_URL (inlined by Next.js). Used by the
# Netlify branch context so a branch deploy goes live with no dashboard setup.
# NEXT_PUBLIC_RANA_API_URL=https://staging.api.rana54.com
