# ---------------------------------------------------------------------------
# Rana54 Network Operations - environment
# ---------------------------------------------------------------------------

# Which data adapter the workspace uses.
#   mock  -> in-browser prototype state (seeded, persisted in localStorage)
#   http  -> the real Rana54 operations backend
# Switch this to "http" on the day the backend is ready. No component changes.
NEXT_PUBLIC_DATA_SOURCE=mock

# Base URL of the operations API. Required when NEXT_PUBLIC_DATA_SOURCE=http.
# Point it at the Next.js proxy (/api) or straight at the service.
NEXT_PUBLIC_API_BASE_URL=/api

# Upstream service the built-in /api proxy routes forward to.
# Server-side only: never exposed to the browser.
OPERATIONS_API_URL=http://localhost:8080
OPERATIONS_API_TOKEN=
